# 수오더 환경변수 예시. 실제 값은 .env.local(개발)과 Vercel 환경변수(운영)에만 넣는다.
# 비밀 값을 이 파일·소스코드·채팅에 붙여넣지 말 것.

# ── 기존 (필수) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 거래명세서 OCR · (켰을 때) 논문 브리핑 AI 가 같이 쓴다
ANTHROPIC_API_KEY=
# 크론 경로 보호 (없으면 /api/leave-rollover, /api/briefing-publish 가 인증 없이 열린다)
CRON_SECRET=

# ── 논문 브리핑 (전부 선택 — 없으면 안전한 테스트 모드) ─────
# 카드를 실제 AI로 만들기. 비워 두면 규칙 정리(AI 미사용).
# BRIEFING_AI_PROVIDER=anthropic
# AI 모델 바꾸기 (기본 claude-opus-5-5)
# BRIEFING_AI_MODEL=

# 발행할 때 직원 알림함에 실제로 알림 넣기. 비워 두면 내용만 기록하고 보내지 않는다.
# 개발 PC가 운영 DB에 붙어 있을 때는 켜지 말 것 (직원에게 실제 알림이 간다).
# BRIEFING_INTERNAL_NOTIFY=on

# 네이버웍스 메시지의 링크에 넣을 앱 주소 (예: https://수오더주소). 비워 두면 경로만.
# BRIEFING_APP_URL=

# 네이버웍스 Bot — 아직 연결하지 않음. 연결할 때 docs/paper-briefing.md 의 "네이버웍스 연결" 참고.
# NAVERWORKS_CLIENT_ID=
# NAVERWORKS_CLIENT_SECRET=
# NAVERWORKS_SERVICE_ACCOUNT=
# NAVERWORKS_PRIVATE_KEY=
# NAVERWORKS_BOT_ID=
# NAVERWORKS_CHANNEL_ID=

# 입고 지연 자동 알림 (/api/arrival-delay). on 일 때만 실제로 알림을 보낸다. 없으면 건수만 세는 시험 실행.
# ARRIVAL_DELAY_NOTIFY=on
